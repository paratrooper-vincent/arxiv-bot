# ============================================================
# arxiv-bot 环境变量模板
# 使用方法：复制本文件为 .env，填入真实值。
# .env 已在 .gitignore 中忽略，密钥不会进入版本库。
# ============================================================

# 飞书群「自定义机器人」Webhook 地址
# 留空 = 预览模式（只打印到屏幕，不推送、不记录已推）
FEISHU_WEBHOOK=

# LLM（OpenAI 兼容 chat/completions 接口）
# 用于论文二次理解（相关性判断 + 中文点评）与自动周报
# 留空 LLM_API_KEY = 自动回退关键词方案，程序照常运行
# 示例为智谱开放平台，glm-4-flash 为免费档模型
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# Embedding 向量接口（OpenAI 兼容 /embeddings 接口）
# 用于语义匹配；留空 = 自动回退本地 numpy 语义匹配（零费用）
# 智谱示例：
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_MODEL=embedding-2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
